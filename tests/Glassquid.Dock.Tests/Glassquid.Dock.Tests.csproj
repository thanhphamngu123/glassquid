<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the dock window shell: window-style contracts (WS_EX_NOACTIVATE) and the
    dock settings notification pipe. Separate from Glassquid.Core.Tests because these
    create real WPF windows and read real window styles, so they need net10.0-windows
    and an STA thread; separate from Glassquid.AppServices.Tests because they exercise
    the presentation layer, not the application services.

    Package versions are pinned centrally in Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Glassquid.Dock.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Glassquid.Dock\Glassquid.Dock.csproj" />
    <ProjectReference Include="..\..\src\Glassquid.Settings\Glassquid.Settings.csproj" />
    <ProjectReference Include="..\..\src\Glassquid.Launcher\Glassquid.Launcher.csproj" />
    <ProjectReference Include="../Glassquid.CompatibilityProbe/Glassquid.CompatibilityProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Glassquid.App/Glassquid.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
