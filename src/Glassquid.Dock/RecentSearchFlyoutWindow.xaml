<controls:GlassWindow
    x:Class="Glassquid.Dock.RecentSearchFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Tìm kiếm và Gần đây"
    AutomationProperties.Name="Tìm kiếm và Gần đây"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True"
    Deactivated="OnPopupDeactivated"
    PreviewKeyDown="OnPopupPreviewKeyDown">

  <controls:GlassWindow.Resources>
    <!-- Item Button Style -->
    <Style x:Key="RecentItemButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="54" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#1CFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#30FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Clear / Action Icon Button -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnSurface" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnSurface" Property="Background" Value="#25FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BtnSurface" Property="Background" Value="#40FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim Glass ScrollBar (Glassquid Standard) -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="Grip" Width="4" HorizontalAlignment="Center"
                      CornerRadius="2" Background="{TemplateBinding Background}" Opacity="0.4" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#66FFFFFF" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimScrollThumb}" Background="{TemplateBinding Foreground}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid x:Name="PopupVisualRoot" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,1">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="PopupSlideTransform" Y="16" />
      </Grid.RenderTransform>
      <controls:LiquidGlassSurface x:Name="GlassSurface" />

      <controls:PhoneBorder CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" Padding="14,12"
              Background="Transparent"
              BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
              BorderThickness="1.5">
        <StackPanel Width="440">
          
          <!-- Thanh tìm kiếm kiểu Squircle Pill -->
          <Border Height="44" CornerRadius="14" Padding="12,0" Background="#14FFFFFF"
                  BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                  BorderThickness="1" SnapsToDevicePixels="True" Margin="0,2,0,8">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Search Icon -->
              <Viewbox Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.8">
                <Canvas Width="48" Height="48">
                  <Path Fill="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                        Data="M19.5,4 C28.06,4 35,10.94 35,19.5 C35,23.12 33.75,26.46 31.66,29.11 L43.28,40.72 C43.98,41.43 43.98,42.57 43.28,43.28 C42.57,43.98 41.43,43.98 40.72,43.28 L29.11,31.66 C26.46,33.75 23.12,35 19.5,35 C10.94,35 4,28.06 4,19.5 C4,10.94 10.94,4 19.5,4 Z M19.5,7.5 C12.87,7.5 7.5,12.87 7.5,19.5 C7.5,26.13 12.87,31.5 19.5,31.5 C26.13,31.5 31.5,26.13 31.5,19.5 C31.5,12.87 26.13,7.5 19.5,7.5 Z" />
                </Canvas>
              </Viewbox>

              <!-- Search Input & Placeholder -->
              <Grid Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="PlaceholderText" Text="Tìm kiếm ứng dụng, tệp tin..."
                           FontSize="14" Opacity="0.5" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                <TextBox x:Name="SearchInputBox" Height="36" FontSize="14" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="#39C5F6"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchInputKeyDown" />
              </Grid>

              <!-- Clear Button (✕) -->
              <Button x:Name="ClearButton" Grid.Column="2" Width="26" Height="26" Style="{StaticResource IconButton}"
                      Visibility="Collapsed" Click="OnClearButtonClick" ToolTip="Xóa nội dung">
                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Opacity="0.75"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
              </Button>
            </Grid>
          </Border>

          <!-- Loading Bar -->
          <ProgressBar x:Name="SearchProgressBar" IsIndeterminate="True" Height="2" Margin="0,0,0,4"
                       Foreground="#39C5F6" Background="Transparent" BorderThickness="0" Visibility="Collapsed" />

          <!-- Section Title Header -->
          <Grid Margin="6,6,6,6">
            <TextBlock x:Name="SectionTitleText" Text="Tìm kiếm gần đây" FontSize="13" FontWeight="SemiBold"
                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
            <TextBlock x:Name="ItemCountText" HorizontalAlignment="Right" FontSize="12" Opacity="0.5"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          </Grid>

          <!-- Scrollable Results List with UI Virtualization and Recycling -->
          <Grid MaxHeight="390">
            <ListBox x:Name="ResultsList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,4,0"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ScrollViewer Focusable="False"
                                CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Padding="{TemplateBinding Padding}">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RecentItemButtonStyle}" Click="OnItemClick" Tag="{Binding}">
                    <Grid Margin="4,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <!-- Icon -->
                      <Border Width="34" Height="34" CornerRadius="8" Background="#12FFFFFF"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>

                      <!-- DisplayName & Subtitle -->
                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="0,1,0,0" Opacity="0.65"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                      </StackPanel>

                      <!-- Relative Time -->
                      <TextBlock Grid.Column="2" Text="{Binding RelativeTimeText}" FontSize="11.5" Opacity="0.55"
                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                 Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state text -->
            <TextBlock x:Name="EmptyResultsText" Text="Không tìm thấy tệp hoặc ứng dụng nào."
                       Margin="12,30" TextAlignment="Center" FontSize="13" Opacity="0.6" Visibility="Collapsed"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          </Grid>

        </StackPanel>
      </controls:PhoneBorder>
    </Grid>
  </Border>
</controls:GlassWindow>
