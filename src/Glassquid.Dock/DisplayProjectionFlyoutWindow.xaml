<controls:GlassWindow
    x:Class="Glassquid.Dock.DisplayProjectionFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Project"
    AutomationProperties.Name="Project"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True"
    Deactivated="OnPopupDeactivated"
    PreviewKeyDown="OnPopupPreviewKeyDown">
  <controls:GlassWindow.Resources>
    <Style x:Key="ProjectionChoiceButton" TargetType="Button">
      <Setter Property="Height" Value="64" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverSurface" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverSurface" Property="Background" Value="#38FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProjectionFooterButton" TargetType="Button">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="FooterSurface" Background="Transparent" CornerRadius="10">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FooterSurface" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FooterSurface" Property="Background" Value="#38FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid x:Name="PopupVisualRoot" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="PopupSlideTransform" Y="12" />
      </Grid.RenderTransform>
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <controls:PhoneBorder CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" Padding="12,12"
              Background="Transparent"
              BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
              BorderThickness="1.5">
        <StackPanel Width="380">
          <Grid Margin="3,3,4,8" Height="36">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="38" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ProjectionFooterButton}" Width="36" Height="34" Padding="0" Click="OnBackClick"
                    AutomationProperties.Name="Close Project panel" ToolTip="Close">
              <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
            </Button>
            <TextBlock Grid.Column="1" Text="Project" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          </Grid>

          <ItemsControl x:Name="ProjectionChoicesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ProjectionChoiceButton}" Tag="{Binding}"
                        Click="OnProjectionChoiceClick" AutomationProperties.Name="{Binding DisplayName}">
                  <Border x:Name="ChoiceSurface" Background="Transparent" CornerRadius="12">
                    <Grid>
                      <Border x:Name="SelectionStripe" Width="3" Height="26" CornerRadius="2"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="#39C5F6" Visibility="Collapsed" />
                      <Grid Margin="15,0,12,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding IconElement}" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                      </Grid>
                    </Grid>
                  </Border>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="ChoiceSurface" Property="Background" Value="#2AFFFFFF" />
                    <Setter TargetName="SelectionStripe" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="12,8,12,2"
                     FontSize="11" TextWrapping="Wrap"
                     Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />

          <Border Height="1" Margin="0,8,0,3" Background="#20FFFFFF" />
          <Button Style="{StaticResource ProjectionFooterButton}" Click="OnMoreDisplaySettingsClick"
                  AutomationProperties.Name="More display settings">
            <TextBlock Text="More display settings" FontSize="13" Opacity="0.82"
                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          </Button>
        </StackPanel>
      </controls:PhoneBorder>
    </Grid>
  </Border>
</controls:GlassWindow>
