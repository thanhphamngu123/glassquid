<controls:GlassWindow
    x:Class="Glassquid.Dock.WifiPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Kết nối Wi-Fi"
    AutomationProperties.Name="Mật khẩu Wi-Fi"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    Topmost="True"
    SnapsToDevicePixels="True">
  <Border Background="Transparent">
    <Grid>
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <controls:PhoneBorder CornerRadius="28" Padding="20" Background="Transparent" BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" BorderThickness="1.5">
        <StackPanel Width="320">
          <TextBlock Text="Kết nối mạng Wi-Fi" FontSize="16" FontWeight="SemiBold" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          <TextBlock x:Name="NetworkNameText" Margin="0,5,0,12" FontSize="12" TextTrimming="CharacterEllipsis" Opacity="0.76" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          <PasswordBox x:Name="WifiPasswordBox" Height="36" Padding="9,6" FontSize="13" Background="#18FFFFFF" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" BorderBrush="#38FFFFFF" BorderThickness="1" />
          <TextBlock x:Name="ValidationText" Visibility="Collapsed" Margin="2,6,2,0" FontSize="11" Text="Nhập mật khẩu để tiếp tục." Foreground="#FFFF9B9B" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="86" Height="34" Margin="0,0,8,0" Click="OnCancelClick" Content="Hủy" />
            <Button Width="100" Height="34" IsDefault="True" Click="OnConnectClick" Content="Kết nối" />
          </StackPanel>
        </StackPanel>
      </controls:PhoneBorder>
    </Grid>
  </Border>
</controls:GlassWindow>
