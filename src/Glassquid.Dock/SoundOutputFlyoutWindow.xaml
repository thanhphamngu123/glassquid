<controls:GlassWindow
    x:Class="Glassquid.Dock.SoundOutputFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Sound output"
    AutomationProperties.Name="Sound output"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True"
    Deactivated="OnPopupDeactivated"
    PreviewKeyDown="OnPopupPreviewKeyDown">
  <controls:GlassWindow.Resources>
    <FontFamily x:Key="PanelIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Sound Device Choice Button Style -->
    <Style x:Key="SoundChoiceButton" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HoverSurface" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverSurface" Property="Background" Value="#1AFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverSurface" Property="Background" Value="#2DFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Header / Footer Button Style -->
    <Style x:Key="SoundHeaderButton" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnSurface" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnSurface" Property="Background" Value="#1AFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BtnSurface" Property="Background" Value="#2DFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SoundFooterLinkButton" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="FooterSurface" Background="Transparent" CornerRadius="8">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FooterSurface" Property="Background" Value="#1AFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FooterSurface" Property="Background" Value="#2DFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Volume Mixer Glass Capsule Slider Style (matching QuickSettings Control Center) -->
    <Style x:Key="MixerSlider" TargetType="Slider">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Value" Value="50" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="28">
              <Border Height="4" Margin="0,0,0,0" VerticalAlignment="Center" CornerRadius="2" Background="#28FFFFFF" />
              <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#A6FFFFFF" BorderThickness="0" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="30" Height="18" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid SnapsToDevicePixels="True">
                          <!-- Outer vector soft shadow for floating depth -->
                          <Border CornerRadius="9" Margin="0,1.5,0,-1.5" Background="#22000000" />

                          <!-- Glass body with translucent gradient and specular rim border -->
                          <Border x:Name="ThumbGlassBody" CornerRadius="9" BorderThickness="1">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                <GradientStop Color="#20FFFFFF" Offset="0.45" />
                                <GradientStop Color="#10FFFFFF" Offset="0.55" />
                                <GradientStop Color="#30FFFFFF" Offset="1" />
                              </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B8FFFFFF" Offset="0" />
                                <GradientStop Color="#40FFFFFF" Offset="0.45" />
                                <GradientStop Color="#65FFFFFF" Offset="1" />
                              </LinearGradientBrush>
                            </Border.BorderBrush>

                            <!-- Upper glass reflection glint -->
                            <Border Height="8" VerticalAlignment="Top" Margin="1,1,1,0" CornerRadius="8,8,3,3">
                              <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#50FFFFFF" Offset="0" />
                                  <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                              </Border.Background>
                            </Border>
                          </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbGlassBody" Property="Background">
                              <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#75FFFFFF" Offset="0" />
                                  <GradientStop Color="#35FFFFFF" Offset="0.45" />
                                  <GradientStop Color="#20FFFFFF" Offset="0.55" />
                                  <GradientStop Color="#45FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                              </Setter.Value>
                            </Setter>
                            <Setter TargetName="ThumbGlassBody" Property="BorderBrush">
                              <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#EFFFFFFF" Offset="0" />
                                  <GradientStop Color="#60FFFFFF" Offset="0.45" />
                                  <GradientStop Color="#85FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                              </Setter.Value>
                            </Setter>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbGlassBody" Property="Background">
                              <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#90FFFFFF" Offset="0" />
                                  <GradientStop Color="#45FFFFFF" Offset="0.45" />
                                  <GradientStop Color="#28FFFFFF" Offset="0.55" />
                                  <GradientStop Color="#60FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                              </Setter.Value>
                            </Setter>
                            <Setter TargetName="ThumbGlassBody" Property="BorderBrush">
                              <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#FFFFFFFF" Offset="0" />
                                  <GradientStop Color="#75FFFFFF" Offset="0.45" />
                                  <GradientStop Color="#95FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                              </Setter.Value>
                            </Setter>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#20FFFFFF" BorderThickness="0" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim Glass ScrollBar -->
    <Style x:Key="SoundScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SoundSlimScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="Grip" Width="4" HorizontalAlignment="Center"
                      CornerRadius="2" Background="{TemplateBinding Background}" Opacity="0.4" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#66FFFFFF" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SoundScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SoundSlimScrollThumb}" Background="{TemplateBinding Foreground}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SoundScrollPageButton}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid x:Name="PopupVisualRoot" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="PopupSlideTransform" Y="12" />
      </Grid.RenderTransform>
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <controls:PhoneBorder CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" Padding="14,12"
              Background="Transparent"
              BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
              BorderThickness="1.5">
        <StackPanel Width="380">

          <!-- Header -->
          <Grid Margin="2,2,2,8" Height="36">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="38" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SoundHeaderButton}" Width="36" Height="34" Click="OnBackClick"
                    AutomationProperties.Name="Sound output quay lại" ToolTip="Quay lại">
              <TextBlock Text="&#xE72B;" FontFamily="{StaticResource PanelIconFont}" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
            </Button>
            <TextBlock Grid.Column="1" Text="Sound output" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
          </Grid>

          <!-- Scrollable Body -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        MaxHeight="520" Focusable="False">
            <StackPanel Margin="0,0,4,0">

              <!-- Section: Output device -->
              <TextBlock Text="Output device" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                         Margin="6,4,0,6" />

              <ItemsControl x:Name="OutputDevicesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SoundChoiceButton}" Click="OnDeviceItemClick" Tag="{Binding Id}">
                      <Border x:Name="ChoiceSurface" Background="Transparent" CornerRadius="10">
                        <Grid>
                          <!-- Selection Indicator Bar -->
                          <Border x:Name="SelectionStripe" Width="3.5" Height="18" CornerRadius="1.75" Background="#39C5F6"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />

                          <Grid Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="28" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Device Icon -->
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource PanelIconFont}"
                                       FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />

                            <!-- Device Name -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                                       TextTrimming="CharacterEllipsis" Margin="4,0,4,0" />
                          </Grid>
                        </Grid>
                      </Border>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsDefault}" Value="True">
                        <Setter TargetName="ChoiceSurface" Property="Background" Value="#20FFFFFF" />
                        <Setter TargetName="SelectionStripe" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="#18FFFFFF" Margin="6,10" />

              <!-- Section: Spatial sound -->
              <TextBlock Text="Spatial sound" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                         Margin="6,2,0,6" />

              <Button x:Name="SpatialOffButton" Style="{StaticResource SoundChoiceButton}" Click="OnSpatialSoundOffClick">
                <Border x:Name="SpatialOffSurface" Background="#20FFFFFF" CornerRadius="10">
                  <Grid>
                    <Border x:Name="SpatialOffIndicator" Width="3.5" Height="18" CornerRadius="1.75" Background="#39C5F6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Visible" />
                    <TextBlock Text="Off" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  </Grid>
                </Border>
              </Button>

              <Button x:Name="SpatialSonicButton" Style="{StaticResource SoundChoiceButton}" Click="OnSpatialSoundSonicClick">
                <Border x:Name="SpatialSonicSurface" Background="Transparent" CornerRadius="10">
                  <Grid>
                    <Border x:Name="SpatialSonicIndicator" Width="3.5" Height="18" CornerRadius="1.75" Background="#39C5F6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock Text="Windows Sonic for Headphones" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  </Grid>
                </Border>
              </Button>

              <TextBlock x:Name="SpatialNotSupportedHint" Text="Không khả dụng cho thiết bị này" FontSize="11" Margin="10,2,0,2"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                         Visibility="Collapsed" />

              <Border Height="1" Background="#18FFFFFF" Margin="6,10" />

              <!-- Section: Volume mixer -->
              <Grid Margin="6,2,6,8">
                <TextBlock Text="Volume mixer" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                <Button Style="{StaticResource SoundHeaderButton}" Width="30" Height="28" HorizontalAlignment="Right"
                        Click="OnOpenMixerSettingsClick" ToolTip="Cài đặt bộ trộn âm lượng" AutomationProperties.Name="Cài đặt bộ trộn âm lượng">
                  <TextBlock Text="&#xE713;" FontFamily="{StaticResource PanelIconFont}" FontSize="14"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                </Button>
              </Grid>

              <!-- Master Device Volume Slider Row -->
              <Grid Height="38" Margin="6,0,6,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MasterDeviceIcon" Text="&#xE7F6;" FontFamily="{StaticResource PanelIconFont}"
                           FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />

                <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Style="{StaticResource MixerSlider}" Margin="8,0,8,0"
                        ValueChanged="OnMasterVolumeSliderValueChanged" />

                <TextBlock x:Name="MasterVolumePercentText" Grid.Column="2" Text="50%" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
              </Grid>

              <!-- App Audio Sessions List -->
              <ItemsControl x:Name="AppSessionsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="38" Margin="6,2,6,2" ToolTip="{Binding DisplayName}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                      </Grid.ColumnDefinitions>

                      <!-- App Icon or Fallback -->
                      <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Width="20" Height="20">
                        <Image x:Name="AppIconImg" Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="FallbackGlyphTxt" Text="{Binding FallbackGlyph}" FontFamily="{StaticResource PanelIconFont}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                      </Grid>

                      <!-- App Volume Slider -->
                      <Slider Grid.Column="1" Style="{StaticResource MixerSlider}" Margin="8,0,8,0"
                              Value="{Binding VolumePercent, Mode=TwoWay}" />

                      <!-- App Volume Percent Text -->
                      <TextBlock Grid.Column="2" Text="{Binding VolumePercentText}" FontSize="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter TargetName="AppIconImg" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="FallbackGlyphTxt" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="#18FFFFFF" Margin="6,10" />

              <!-- Footer: More volume settings -->
              <Button Style="{StaticResource SoundFooterLinkButton}" Click="OnMoreVolumeSettingsClick"
                      ToolTip="Mở cài đặt âm thanh Windows">
                <TextBlock Text="More volume settings" FontSize="13"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
              </Button>

            </StackPanel>
          </ScrollViewer>

        </StackPanel>
      </controls:PhoneBorder>
    </Grid>
  </Border>
</controls:GlassWindow>
