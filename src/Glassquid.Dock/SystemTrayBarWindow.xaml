<controls:GlassWindow
    x:Class="Glassquid.Dock.SystemTrayBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Glassquid System Tray"
    AutomationProperties.Name="Đồng hồ và khay hệ thống"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True">

  <controls:GlassWindow.Resources>
    <SolidColorBrush x:Key="ChargingBatteryBrush" Color="#5BD364" />
    <Style x:Key="WindowsTrayGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style x:Key="NetworkGlyphStyle" TargetType="Path">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style x:Key="BatteryGlyphStyle" TargetType="Path">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Fill" Value="{StaticResource ChargingBatteryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NotificationGlyphStyle" TargetType="Path">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style x:Key="SystemTrayButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HiddenIconsButtonStyle" TargetType="Button" BasedOn="{StaticResource SystemTrayButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChevronTile" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChevronTile" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="Tag" Value="True">
                <Setter TargetName="ChevronTile" Property="Background" Value="#38FFFFFF" />
                <Setter TargetName="ChevronTile" Property="BorderBrush" Value="#55FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChevronTile" Property="Background" Value="#55FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid ClipToBounds="True">
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <Grid x:Name="SystemTrayVisualRoot" ClipToBounds="True">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="SystemTraySlideTransform" />
        </Grid.RenderTransform>
        <controls:PhoneBorder x:Name="SystemTrayPanelBorder"
                CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                BorderThickness="1.5"
                IsHitTestVisible="False" />
        <StackPanel x:Name="SystemTrayContentLayer" Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">
          <Button x:Name="HiddenIconsButton" Width="30" Height="56" Margin="0,0,6,0"
                  Visibility="Collapsed" Style="{StaticResource HiddenIconsButtonStyle}" Tag="False"
                  ToolTip="Biểu tượng khay hệ thống"
                  AutomationProperties.Name="Show hidden icons"
                  PreviewMouseDown="OnHiddenIconsPreviewMouseDown"
                  Click="OnHiddenIconsClick">
            <TextBlock x:Name="HiddenIconsGlyph" Text="&#xE70E;" FontSize="16"
                       Style="{StaticResource WindowsTrayGlyph}" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform x:Name="HiddenIconsChevronRotation" Angle="0" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Button>

          <Button x:Name="InputLanguageButton" Width="30" Height="56" Margin="0,0,6,0"
                  Style="{StaticResource SystemTrayButton}"
                  ToolTip="Bấm để đổi ngôn ngữ nhập"
                  AutomationProperties.Name="Ngôn ngữ nhập"
                  PreviewMouseDown="OnInputLanguagePreviewMouseDown"
                  Click="OnInputLanguageClick">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="InputLanguageText" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="InputLanguageRegionText" HorizontalAlignment="Center" FontSize="8"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
          </Button>

          <Button x:Name="NetworkButton" Width="30" Height="56" Margin="0,0,6,0"
                  Style="{StaticResource SystemTrayButton}"
                  ToolTip="Mở Wi-Fi và cài đặt nhanh"
                  AutomationProperties.Name="Wi-Fi và mạng"
                  Click="OnQuickSettingsClick">
            <Path x:Name="NetworkGlyph" Style="{StaticResource NetworkGlyphStyle}" />
          </Button>

          <Button x:Name="VolumeButton" Width="30" Height="56" Margin="0,0,6,0"
                  Style="{StaticResource SystemTrayButton}"
                  ToolTip="Mở cài đặt nhanh để điều chỉnh âm lượng"
                  AutomationProperties.Name="Âm lượng"
                  Click="OnQuickSettingsClick">
            <TextBlock x:Name="VolumeGlyph" Text="&#xE995;" FontSize="18" Style="{StaticResource WindowsTrayGlyph}" />
          </Button>

          <Button x:Name="BatteryButton" Width="30" Height="56" Margin="0,0,6,0"
                  Style="{StaticResource SystemTrayButton}"
                  ToolTip="Mở cài đặt pin"
                  AutomationProperties.Name="Pin"
                  Click="OnQuickSettingsClick">
            <Path x:Name="BatteryGlyph" Style="{StaticResource BatteryGlyphStyle}" />
          </Button>

          <Button x:Name="ClockButton" Height="56" Margin="0,0,6,0" Padding="5,0"
                  Style="{StaticResource SystemTrayButton}"
                  ToolTip="Mở ngày, giờ và thông báo của Windows"
                  AutomationProperties.Name="Đồng hồ và ngày tháng"
                  Click="OnNotificationsClick">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="ClockText" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="DateText" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
          </Button>

          <Button x:Name="NotificationsButton" Width="30" Height="56"
                  Style="{StaticResource SystemTrayButton}"
                  ToolTip="Mở trung tâm thông báo"
                  AutomationProperties.Name="Thông báo"
                  Click="OnNotificationsClick">
            <Path x:Name="NotificationsGlyph" Style="{StaticResource NotificationGlyphStyle}" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</controls:GlassWindow>
