<controls:GlassWindow
    x:Class="Glassquid.Dock.HiddenTrayIconsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Biểu tượng khay Glassquid"
    AutomationProperties.Name="Biểu tượng khay ứng dụng"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True"
    Deactivated="OnPopupDeactivated">
  <controls:GlassWindow.Resources>
    <Style x:Key="TrayIconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="IconTile" Background="Transparent" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconTile" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconTile" Property="Background" Value="#44FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid x:Name="PopupVisualRoot" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,1">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="PopupSlideTransform" Y="26" />
      </Grid.RenderTransform>
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <controls:PhoneBorder x:Name="PopupMotionTint" CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" Background="#FF686868"
              Opacity="0" IsHitTestVisible="False" />
      <controls:PhoneBorder CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" Padding="14,12" Background="Transparent"
              BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
              BorderThickness="1.5">
        <StackPanel>
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TrayIconsList" Width="160">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Width="160" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TrayIconButton}" Tag="{Binding}"
                          ToolTip="{Binding ToolTip}"
                          PreviewMouseLeftButtonDown="OnTrayIconPreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonUp="OnTrayIconRightButtonUp"
                          AutomationProperties.Name="{Binding ToolTip}">
                    <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="EmptyStateText" Text="Không có biểu tượng ứng dụng đang chạy."
                     Width="160" MaxWidth="160" TextWrapping="Wrap" Margin="4,2,4,4"
                     Visibility="Collapsed" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
        </StackPanel>
      </controls:PhoneBorder>
    </Grid>
  </Border>
</controls:GlassWindow>
