<controls:GlassWindow
    x:Class="Glassquid.Dock.NotificationsFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Trung tâm thông báo Glassquid"
    AutomationProperties.Name="Trung tâm thông báo Glassquid"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True"
    Deactivated="OnPopupDeactivated"
    PreviewKeyDown="OnPopupPreviewKeyDown">

  <controls:GlassWindow.Resources>
    <FontFamily x:Key="PanelIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Standard Button Style -->
    <Style x:Key="FlyoutButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Tile" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Opacity" Value="0.86" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Tile" Property="Opacity" Value="0.70" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Calendar Day Button -->
    <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DayBorder" Background="{TemplateBinding Background}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DayBorder" Property="Background" Value="#25FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DayBorder" Property="Background" Value="#40FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Slim Glass ScrollBar -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="Grip" Width="4" HorizontalAlignment="Center"
                      CornerRadius="2" Background="{TemplateBinding Background}" Opacity="0.4" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#66FFFFFF" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimScrollThumb}" Background="{TemplateBinding Foreground}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border Background="Transparent" SnapsToDevicePixels="True">
    <Grid x:Name="PopupVisualRoot" Opacity="0" RenderTransformOrigin="0.5,1">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="PopupSlideTransform" Y="16" />
      </Grid.RenderTransform>
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <controls:PhoneBorder CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" Padding="14" Background="Transparent"
              BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
              BorderThickness="1.5">
        <StackPanel Width="365">

          <!-- 1. Header: Title (Left), DND Toggle (Center), Clear All (Right) -->
          <Grid Margin="4,2,4,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Thông báo + Count Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="Thông báo" FontSize="15" FontWeight="SemiBold"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
              <Border x:Name="NotificationCountBadge" Margin="7,0,0,0" Padding="6,1.5" CornerRadius="10"
                      Background="#30FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="NotificationCountText" Text="0" FontSize="11" FontWeight="Bold"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
              </Border>
            </StackPanel>

            <!-- Center: Do Not Disturb Toggle Button -->
            <Button x:Name="DndToggleButton" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource FlyoutButton}"
                    ToolTip="Chế độ Không làm phiền (Bật/Tắt)" Click="OnDndToggleClick" VerticalAlignment="Center">
              <Border x:Name="DndButtonBubble" CornerRadius="14" Padding="10,4.5" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="DndIcon" Text="&#xED39;" FontFamily="{StaticResource PanelIconFont}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                  <TextBlock x:Name="DndText" Text="Không làm phiền" FontSize="11.5" FontWeight="Medium" Margin="6,0,0,0"
                             Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Button>

            <!-- Right: Clear All Button -->
            <Button x:Name="ClearAllButton" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource FlyoutButton}"
                    ToolTip="Xóa tất cả thông báo" Click="OnClearAllClick" Visibility="Collapsed" VerticalAlignment="Center">
              <Border CornerRadius="12" Padding="9,4.5" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                <TextBlock Text="Xóa tất cả" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
              </Border>
            </Button>
          </Grid>

          <!-- 2. Notifications List / Scrollable Container (Fixed Height) -->
          <Grid Height="260">
            <!-- Scrollable list of cards -->
            <ScrollViewer x:Name="NotificationScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="NotificationCardsContainer" Margin="0,0,2,0" />
            </ScrollViewer>

            <!-- Empty State when 0 notifications -->
            <Border x:Name="EmptyStateBorder" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,14" Visibility="Visible">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,8">
                  <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource PanelIconFont}" FontSize="20" Foreground="#A0FFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Không có thông báo mới" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                <TextBlock Text="Bạn đã cập nhật mọi thông tin gần đây." FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                <!-- Test notification trigger -->
                <Button Style="{StaticResource FlyoutButton}" Margin="0,10,0,0" Padding="12,5" HorizontalAlignment="Center"
                        Click="OnSendTestNotificationClick">
                  <Border CornerRadius="12" Padding="10,4" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <TextBlock Text="+ Tạo thông báo thử" FontSize="11" Foreground="#0A84FF" FontWeight="Medium" />
                  </Border>
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Separator Line -->
          <Border Height="1" Background="#18FFFFFF" Margin="2,10,2,8" SnapsToDevicePixels="True" />

          <!-- 3. Calendar & Date Section -->
          <DockPanel Margin="4,2,4,6">
            <TextBlock x:Name="CalendarFullDateText" Text="Hôm nay" FontSize="13" FontWeight="SemiBold"
                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
            <Button x:Name="CalendarExpandCollapseButton" DockPanel.Dock="Right" Style="{StaticResource FlyoutButton}"
                    Padding="6,4" Click="OnCalendarExpandCollapseClick" ToolTip="Thu gọn/Mở rộng lịch">
              <TextBlock x:Name="CalendarChevronGlyph" Text="&#xE70E;" FontFamily="{StaticResource PanelIconFont}" FontSize="12"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform x:Name="CalendarChevronRotation" Angle="180" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Button>
          </DockPanel>

          <!-- Collapsible Calendar Grid Container -->
          <StackPanel x:Name="CalendarContainer" Visibility="Visible">
            <Border CornerRadius="18" Padding="10,8" Margin="0,2,0,6" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
              <StackPanel>
                <!-- Month / Year navigation header -->
                <DockPanel Margin="4,0,4,6">
                  <TextBlock x:Name="CalendarMonthYearText" Text="Tháng 10, 2026" FontSize="12" FontWeight="SemiBold"
                             Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource FlyoutButton}" Width="26" Height="26" ToolTip="Tháng trước" Click="OnPrevMonthClick">
                      <TextBlock Text="&#xE76B;" FontFamily="{StaticResource PanelIconFont}" FontSize="10"
                                 Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                    </Button>
                    <Button Style="{StaticResource FlyoutButton}" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Tháng sau" Click="OnNextMonthClick">
                      <TextBlock Text="&#xE76C;" FontFamily="{StaticResource PanelIconFont}" FontSize="10"
                                 Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                    </Button>
                  </StackPanel>
                </DockPanel>

                <!-- Day of week column headers -->
                <UniformGrid Columns="7" Margin="0,0,0,4">
                  <TextBlock Text="T2" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  <TextBlock Text="T3" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  <TextBlock Text="T4" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  <TextBlock Text="T5" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  <TextBlock Text="T6" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  <TextBlock Text="T7" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                  <TextBlock Text="CN" FontSize="10" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                </UniformGrid>

                <!-- Dynamic 6x7 Calendar Grid of Day Cells -->
                <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6" />
              </StackPanel>
            </Border>

            <!-- 4. Focus Session (Tính năng tập trung của Windows 11) -->
            <Border CornerRadius="18" Padding="12,9" Margin="0,2,0,4" Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource PanelIconFont}" FontSize="12" Foreground="#A78BFA" VerticalAlignment="Center" />
                    <TextBlock Text="Phiên tập trung" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                               Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Stepper minutes -->
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlyoutButton}" Width="22" Height="22" Click="OnFocusMinusClick" ToolTip="Giảm 5 phút">
                      <Border Width="22" Height="22" CornerRadius="11" Background="#20FFFFFF">
                        <TextBlock Text="−" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                      </Border>
                    </Button>
                    <TextBlock x:Name="FocusDurationText" Text="30 phút" FontSize="12" FontWeight="Medium" Margin="8,0" VerticalAlignment="Center"
                               Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" />
                    <Button Style="{StaticResource FlyoutButton}" Width="22" Height="22" Click="OnFocusPlusClick" ToolTip="Tăng 5 phút">
                      <Border Width="22" Height="22" CornerRadius="11" Background="#20FFFFFF">
                        <TextBlock Text="+" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                      </Border>
                    </Button>
                  </StackPanel>
                </StackPanel>

                <!-- Start/Stop Focus button (aligned to the right) -->
                <Button x:Name="FocusActionButton" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource FlyoutButton}" VerticalAlignment="Center"
                        Click="OnFocusActionClick">
                  <Border x:Name="FocusActionBubble" CornerRadius="14" Padding="14,7" Background="#258B5CF6" BorderBrush="#458B5CF6" BorderThickness="1">
                    <TextBlock x:Name="FocusActionText" Text="Bắt đầu" FontSize="12" FontWeight="SemiBold" Foreground="#DDD6FE" />
                  </Border>
                </Button>
              </Grid>
            </Border>
          </StackPanel>

          <!-- 5. Footer: Windows Notification Settings Shortcut -->
          <DockPanel Margin="4,6,4,2">
            <Button Style="{StaticResource FlyoutButton}" Padding="4,2" Click="OnOpenWindowsNotificationSettingsClick"
                    ToolTip="Mở cài đặt thông báo của Windows">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource PanelIconFont}" FontSize="11" Opacity="0.75"
                           Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
                <TextBlock Text="Cài đặt thông báo Windows" FontSize="11" Margin="6,0,0,0" Opacity="0.75"
                           Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DockPanel>

        </StackPanel>
      </controls:PhoneBorder>
    </Grid>
  </Border>
</controls:GlassWindow>
