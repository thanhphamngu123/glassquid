<!-- =========================================================================================
     CỬA SỔ DOCK TÌM KIẾM BÊN TRÁI (SEARCH DOCK WINDOW)
     - Cửa sổ kính mờ (Liquid Glass) đặt ở mép màn hình (mặc định góc dưới bên trái, hoặc cạnh trên).
     - Chứa nút kích hoạt tìm kiếm nhanh với hiệu ứng viên thuốc (Capsule) và biểu tượng kính lúp.
     ========================================================================================= -->
<controls:GlassWindow
    x:Class="Glassquid.Dock.SearchDockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Glassquid.UI.Controls;assembly=Glassquid.UI"
    Title="Glassquid Search"
    AutomationProperties.Name="Glassquid Search"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    SnapsToDevicePixels="True">

  <controls:GlassWindow.Resources>
    <!-- Template nút bấm trong suốt không viền, đổi trỏ chuột thành bàn tay -->
    <Style x:Key="DockEntryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <!-- Lớp khung bao ngoài trong suốt -->
  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <!-- Grid cắt góc bo tròn (Squircle) để hiệu ứng kính không bị tràn ra ngoài -->
    <Grid ClipToBounds="True">
      <!-- Bề mặt kính thủy tinh lỏng (Liquid Glass Surface) chịu trách nhiệm mờ nền và viền phản chiếu -->
      <controls:LiquidGlassSurface x:Name="GlassSurface" />

      <!-- Lớp visual root: hỗ trợ scale tỉ lệ kích thước và animation trượt Auto-Hide -->
      <Grid x:Name="SearchDockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <!-- Transform dịch chuyển Y khi thanh dock trượt ẩn/hiện -->
          <TranslateTransform x:Name="SearchDockSlideTransform" />
        </Grid.RenderTransform>
        <controls:PhoneBorder x:Name="SearchDockPanelBorder"
                CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=controls:GlassWindow}}"
                BorderThickness="1.5"
                IsHitTestVisible="False" />

        <!-- =========================================================================================
             GIAO DIỆN THANH DOCK SEARCH ĐÃ ĐƯỢC COMMENT OUT THEO YÊU CẦU
             ========================================================================================= -->
        <!--
        <StackPanel x:Name="SearchDockContentLayer" Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">
