<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings centre. Phase 1 ships a placeholder; the eight pages arrive across phases 2-6.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Glassquid.Settings</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <AssemblyName>Glassquid.Settings</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glassquid.Core\Glassquid.Core.csproj" />
    <ProjectReference Include="..\Glassquid.UI\Glassquid.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\TransferQr\*.png"
                      LogicalName="Glassquid.Settings.TransferQr.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
