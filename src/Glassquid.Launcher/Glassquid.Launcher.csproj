<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Launchpad. Phase 1 ships the window shell only; the grid, paging, search and grouping
    arrive in phase 5.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Glassquid.Launcher</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glassquid.Core\Glassquid.Core.csproj" />
    <ProjectReference Include="..\Glassquid.UI\Glassquid.UI.csproj" />
    <ProjectReference Include="..\Glassquid.AppServices\Glassquid.AppServices.csproj" />
  </ItemGroup>

</Project>
